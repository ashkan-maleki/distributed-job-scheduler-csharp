## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# .NET
*.dll
*.exe
*.pdb
*.cache
*.deps.json
*.runtimeconfig.json

# ASP.NET Core
appsettings.Development.json

# NuGet
*.nupkg
*.snupkg
packages/
.nuget/
project.lock.json
project.fragment.lock.json
artifacts/

# Test Results
[Tt]est[Rr]esult*/
[Bb]enchmark[Dd]ot[Nn]et.Artifacts/

# VS Code
.vscode/

# Visual Studio
.vs/

# Rider / JetBrains
.idea/
*.sln.iml

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Coverage
coverage/
coverage.xml
*.coverage
*.coveragexml

# Publish output
publish/

# Temporary files
tmp/
temp/

# Generated files
Generated/

# SQLite DB files
*.db
*.db-shm
*.db-wal
